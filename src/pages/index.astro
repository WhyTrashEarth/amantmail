---
import "../styles/global.css";

const pageTitle = "AmantMail — Professional email. Mostly for Alec.";
const pageDescription =
  "A private email domain used for correspondence, newsletters, and explaining what AmantMail is to people who asked.";

const features = [
  {
    title: "Independent by design",
    description: "A domain-owned identity without a public platform attached.",
  },
  {
    title: "Standards-based",
    description: "Modern email authentication and transport security.",
  },
  {
    title: "Highly exclusive",
    description: "Current user capacity has already been reached.",
  },
];

const metrics = [
  {
    value: "1",
    label: "Active Users",
  },
  {
    value: "0",
    label: "Open Registrations",
  },
  {
    value: "0",
    label: "Outside Investors",
  },
  {
    value: "100%",
    label: "Email",
  },
];

const infrastructure = [
  "Proton Mail",
  "Custom Domain",
  "SPF",
  "DKIM",
  "DMARC",
  "TLS",
];

const faqs = [
  {
    question: "Can I sign up?",
    answer: "No.",
  },
  {
    question: "Can I invest?",
    answer: "No.",
  },
  {
    question: "Why does this website exist?",
    answer: "People kept asking what AmantMail was.",
  },
  {
    question: "Is it a real email service?",
    answer: 'It is real email. “Service” may be generous.',
  },
  {
    question: "How many users are there?",
    answer: "Precisely enough.",
  },
  {
    question: "Can I contact support?",
    answer: "You will reach the user.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0A0A0A" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#top" aria-label="AmantMail home">
          <svg
            class="brand-icon"
            viewBox="0 0 48 48"
            role="img"
            aria-hidden="true"
          >
            <rect
              x="4"
              y="8"
              width="40"
              height="32"
              rx="7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />
            <path
              d="M7 13L24 27L41 13"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>

          <span class="brand-wordmark">Amant <em>Mail</em></span>
        </a>

        <nav class="desktop-navigation" aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#infrastructure">Infrastructure</a>
          <a href="#security">Security</a>
          <a href="#faq">FAQ</a>
        </nav>

        <div class="status" aria-label="AmantMail is operational">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Operational</span>
        </div>
      </div>
    </header>

    <main id="main-content">
      <section class="hero section" id="top">
        <div class="container hero-inner">
          <p class="eyebrow">Private email infrastructure</p>

          <h1>Professional email.</h1>

          <p class="hero-subheading">Mostly for Alec.</p>

          <p class="hero-description">
            A private email domain used for correspondence, newsletters, and
            explaining what AmantMail is to people who asked.
          </p>

          <div class="hero-actions">
            <button class="button button-primary" id="signup-button" type="button">
              Can I sign up?
            </button>

            <a class="text-link" href="mailto:alec@amantmail.com">
              Email Alec
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <section class="section" id="about" aria-labelledby="features-heading">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">About</p>
            <h2 id="features-heading">Deliberately limited in scope.</h2>
          </div>

          <div class="feature-grid">
            {
              features.map((feature, index) => (
                <article class="feature-card">
                  <p class="card-number">
                    {String(index + 1).padStart(2, "0")}
                  </p>
                  <h3>{feature.title}</h3>
                  <p>{feature.description}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section metrics-section" aria-labelledby="metrics-heading">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Company metrics</p>
            <h2 id="metrics-heading">Measured growth.</h2>
          </div>

          <div class="metrics-grid">
            {
              metrics.map((metric) => (
                <div class="metric">
                  <strong>{metric.value}</strong>
                  <span>{metric.label}</span>
                </div>
              ))
            }
          </div>

          <p class="metrics-caption">User growth remains deliberately flat.</p>
        </div>
      </section>

      <section
        class="section"
        id="infrastructure"
        aria-labelledby="infrastructure-heading"
      >
        <div class="container infrastructure-layout">
          <div class="section-heading">
            <p class="eyebrow">Infrastructure</p>

            <h2 id="infrastructure-heading">
              Built on established internet infrastructure.
            </h2>
          </div>

          <div class="infrastructure-content">
            <p>
              AmantMail uses Proton Mail with a custom domain and modern email
              authentication standards.
            </p>

            <p>
              It does not operate a secret underground data center despite what
              the typography may suggest.
            </p>

            <ul class="technology-list" aria-label="Email infrastructure">
              {
                infrastructure.map((item) => (
                  <li>{item}</li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <section
        class="section security-section"
        id="security"
        aria-labelledby="security-heading"
      >
        <div class="container security-layout">
          <div>
            <p class="eyebrow">Security</p>
            <h2 id="security-heading">Modern standards. Minimal spectacle.</h2>
          </div>

          <p>
            Domain authentication helps receiving mail systems verify that
            messages sent from AmantMail are authorized. Transport encryption
            protects supported connections while email is in transit.
          </p>
        </div>
      </section>

      <section class="section testimonial-section" aria-label="Testimonial">
        <div class="container">
          <blockquote>
            <p>“I sent an email.<br />It arrived.”</p>
            <footer>— Independent internal testing</footer>
          </blockquote>
        </div>
      </section>

      <section class="section" id="faq" aria-labelledby="faq-heading">
        <div class="container faq-layout">
          <div class="section-heading">
            <p class="eyebrow">FAQ</p>
            <h2 id="faq-heading">Questions, answered.</h2>
          </div>

          <div class="faq-list">
            {
              faqs.map((faq) => (
                <details class="faq-item">
                  <summary>{faq.question}</summary>
                  <p>{faq.answer}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section closing-section" aria-labelledby="closing-heading">
        <div class="container closing-inner">
          <p class="eyebrow">One address. One purpose.</p>

          <h2 id="closing-heading">
            Email should be simple.<br />
            Own your domain.<br />
            Control your identity.<br />
            Build things that last.
          </h2>

          <a class="email-address" href="mailto:alec@amantmail.com">
            alec@amantmail.com
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>No accounts. No subscriptions. No investors. Just email.</p>

        <button
          class="version-button"
          id="version-button"
          type="button"
          aria-expanded="false"
          aria-controls="version-message"
        >
          Version 1.0
        </button>
      </div>

      <div class="container">
        <p class="version-message" id="version-message" hidden>
          Built an entire website to explain one email address. Mission
          accomplished.
        </p>
      </div>
    </footer>

    <script>
      const signupButton = document.querySelector("#signup-button");
      const versionButton = document.querySelector("#version-button");
      const versionMessage = document.querySelector("#version-message");

      signupButton?.addEventListener("click", () => {
        signupButton.textContent = "No.";
        signupButton.setAttribute("aria-label", "No sign-ups are available");
      });

      versionButton?.addEventListener("click", () => {
        if (!(versionMessage instanceof HTMLElement)) return;

        const isHidden = versionMessage.hidden;

        versionMessage.hidden = !isHidden;
        versionButton.setAttribute("aria-expanded", String(isHidden));
      });
    </script>
  </body>
</html>